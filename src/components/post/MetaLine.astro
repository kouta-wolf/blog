---
// 日付・カテゴリ(・読了時間などの追加情報)を並べる行。一覧カードと記事ヘッダーで共用する
import { getCategory } from '../../site.config';
import { categoryHref, formatDate, type Post } from '../../lib/posts';

interface Props {
	post: Post;
}

const { post } = Astro.props;
---

<div class="meta-line">
	<time class="date mono" datetime={formatDate(post.data.date)}>{formatDate(post.data.date)}</time>
	<a class="chip tap-target" href={categoryHref(post.data.category)}>{getCategory(post.data.category).name}</a>
	<slot />
</div>

<style>
	.meta-line {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 4px 12px;
		font-size: 13px;
		color: var(--color-muted);
	}

	.chip {
		padding: 2px 10px;
		border-radius: 8px;
		background: var(--color-accent-soft);
		color: var(--color-accent);
		font-weight: 500;
	}
</style>
