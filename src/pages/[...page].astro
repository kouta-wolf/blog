---
import type { GetStaticPaths } from 'astro';
import Layout from '../layouts/Layout.astro';
import ProfileCard from '../components/sidebar/ProfileCard.astro';
import CategoryList from '../components/sidebar/CategoryList.astro';
import { getPublishedPosts, formatDate } from '../lib/posts';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = await getPublishedPosts();
	return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout>
	<ul>
		{
			page.data.map((post) => (
				<li>
					<a href={`/posts/${post.id}/`}>{post.data.title}</a> <span class="mono">{formatDate(post.data.date)}</span>
				</li>
			))
		}
	</ul>
	<ProfileCard slot="sidebar" />
	<CategoryList slot="sidebar" />
</Layout>
