---
import Layout from '../layouts/Layout.astro';
import ListHeader from '../components/ListHeader.astro';
import ProfileCard from '../components/sidebar/ProfileCard.astro';
import CategoryList from '../components/sidebar/CategoryList.astro';
import TagCloud from '../components/sidebar/TagCloud.astro';
import { formatDate, getPublishedPosts, postHref, type Post } from '../lib/posts';

const posts = await getPublishedPosts();

// 年月(YYYY-MM)ごとにまとめる。posts は新しい順なのでグループも新しい順になる
const groups = new Map<string, Post[]>();
for (const post of posts) {
	const key = formatDate(post.data.date).slice(0, 7);
	groups.set(key, [...(groups.get(key) ?? []), post]);
}
---

<Layout title="アーカイブ" description="これまでに書いた記事の年月ごとの一覧">
	<ListHeader label="アーカイブ" title="すべての記事" count={posts.length} />
	{
		[...groups].map(([month, items]) => {
			const [year, m] = month.split('-');
			return (
				<section class="card month" aria-labelledby={`m-${month}`}>
					<h2 id={`m-${month}`}>
						{year}年{Number(m)}月<span class="count mono">{items.length}</span>
					</h2>
					<ul>
						{items.map((post) => (
							<li>
								<time class="mono" datetime={formatDate(post.data.date)}>
									{formatDate(post.data.date).slice(5)}
								</time>
								<a href={postHref(post)}>{post.data.title}</a>
							</li>
						))}
					</ul>
				</section>
			);
		})
	}
	<ProfileCard slot="sidebar" variant="compact" />
	<CategoryList slot="sidebar" />
	<TagCloud slot="sidebar" />
</Layout>

<style>
	.month {
		padding: 24px 32px;
	}

	h2 {
		display: flex;
		align-items: baseline;
		gap: 10px;
		margin-bottom: 8px;
		font-size: 18px;
	}

	.count {
		font-size: 13px;
		font-weight: 400;
		color: var(--color-muted);
	}

	ul {
		padding: 0;
		list-style: none;
	}

	li {
		display: flex;
		gap: 16px;
		align-items: baseline;
	}

	li + li {
		border-top: 1px solid var(--color-line);
	}

	time {
		flex-shrink: 0;
		font-size: 13px;
		color: var(--color-muted);
	}

	a {
		display: block;
		flex: 1;
		padding: 10px 0;
		color: var(--color-text);
		font-size: 15px;
	}

	a:hover {
		color: var(--color-accent);
	}

	@media (max-width: 480px) {
		.month {
			padding: 20px;
		}
	}
</style>
