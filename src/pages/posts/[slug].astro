---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProfileCard from '../../components/sidebar/ProfileCard.astro';
import CategoryList from '../../components/sidebar/CategoryList.astro';
import Toc from '../../components/sidebar/Toc.astro';
import MetaLine from '../../components/post/MetaLine.astro';
import TagList from '../../components/post/TagList.astro';
import PrevNext from '../../components/post/PrevNext.astro';
import { formatDate, getExcerpt, getPublishedPosts, getReadingMinutes } from '../../lib/posts';
import { site } from '../../site.config';
import '../../styles/prose.css';

export async function getStaticPaths() {
	// 新しい順に並んでいるので、i+1 が1つ古い記事、i-1 が1つ新しい記事
	const posts = await getPublishedPosts();
	return posts.map((entry, i) => ({
		params: { slug: entry.id },
		props: { entry, prev: posts[i + 1], next: posts[i - 1] },
	}));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
---

<Layout title={entry.data.title} description={getExcerpt(entry)}>
	<article class="card article">
		<header class="article-header">
			<MetaLine post={entry}>
				<span>約 {getReadingMinutes(entry)} 分で読めます</span>
			</MetaLine>
			<h1>{entry.data.title}</h1>
			<TagList tags={entry.data.tags} />
		</header>
		<div class="prose">
			<Content />
		</div>
		<footer class="article-footer">
			<span>{site.author} · <time datetime={formatDate(entry.data.date)} class="mono">{formatDate(entry.data.date)}</time></span>
			<a href={site.license.url} rel="license" class="tap-target">{site.license.name}</a>
		</footer>
	</article>
	<PrevNext prev={prev} next={next} />
	<ProfileCard slot="sidebar" variant="compact" />
	<Toc slot="sidebar" headings={headings} />
	<CategoryList slot="sidebar" />
</Layout>

<style>
	.article {
		display: flex;
		flex-direction: column;
		gap: 20px;
		padding: 40px 48px;
	}

	.article-header {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding-bottom: 20px;
		border-bottom: 1px solid var(--color-line);
	}

	h1 {
		font-size: 30px;
		line-height: 1.45;
	}

	.article-footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 12px;
		padding-top: 20px;
		border-top: 1px solid var(--color-line);
		font-size: 13px;
		color: var(--color-muted);
	}

	.article-footer a:hover {
		color: var(--color-accent);
	}

	@media (max-width: 860px) {
		.article {
			padding: 32px 28px;
		}
	}

	@media (max-width: 480px) {
		.article {
			padding: 24px 18px;
		}

		h1 {
			font-size: 24px;
		}
	}
</style>
