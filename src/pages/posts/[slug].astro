---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProfileCard from '../../components/sidebar/ProfileCard.astro';
import CategoryList from '../../components/sidebar/CategoryList.astro';
import { getPublishedPosts, formatDate } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description}>
	<article class="card">
		<h1>{entry.data.title}</h1>
		<time datetime={entry.data.date.toISOString()} class="mono">{formatDate(entry.data.date)}</time>
		<Content />
	</article>
	<ProfileCard slot="sidebar" variant="compact" />
	<CategoryList slot="sidebar" />
</Layout>
